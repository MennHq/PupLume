{
  "id": "/",
  "name": "PupLume — AI Puppy Manager",
  "short_name": "PupLume",
  "description": "PupLume is your clean, premium AI puppy companion — effortlessly managing potty routines, nutrition, wellness, and veterinary safety.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#FFF9F2",
  "theme_color": "#8B5E3C",
  "categories": [
    "lifestyle",
    "productivity",
    "utilities"
  ],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/puplume-mobile-preview.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "PupLume Clean Premium Mobile Preview"
    },
    {
      "src": "/screenshots/puplume-desktop-preview.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "PupLume Clean Premium Desktop View"
    }
  ],
  "shortcuts": [
    {
      "name": "Log Potty Break",
      "short_name": "Potty",
      "description": "Quick 1-tap pee, poo, or accident log",
      "url": "/?action=potty",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Log Meal & Water",
      "short_name": "Meal",
      "description": "Quick log puppy food & water bowl",
      "url": "/?action=feeding",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Training Academy",
      "short_name": "Academy",
      "description": "Puppy drills with hands-free timer",
      "url": "/academy",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Lost Dog SOS Alert",
      "short_name": "Lost Dog SOS",
      "description": "Emergency missing puppy broadcast & flyer",
      "url": "/?action=sos",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
