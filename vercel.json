{
  "functions": {
    "api/pup-meta.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/(.*\\.(png|jpg|jpeg|svg|webp))",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share-target",
      "destination": "/api/share-target"
    },
    {
      "source": "/pup/:slug",
      "destination": "/api/pup-meta?slug=:slug"
    },
    {
      "source": "/safety/:slug",
      "destination": "/api/pup-meta?slug=:slug"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
