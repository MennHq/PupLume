{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pup/:slug",
      "destination": "https://petttttttpuplume.vercel.app/pup/:slug",
      "permanent": true
    },
    {
      "source": "/safety/:slug",
      "destination": "https://petttttttpuplume.vercel.app/pup/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/share-target",
      "destination": "/api/share-target"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
