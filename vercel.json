{
  "functions": {
    "api/pup-meta.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share-target",
      "destination": "/api/share-target"
    },
    {
      "source": "/pup/:slug",
      "destination": "/api/pup-meta?slug=:slug"
    },
    {
      "source": "/safety/:slug",
      "destination": "/api/pup-meta?slug=:slug"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
