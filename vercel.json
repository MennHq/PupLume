{
  "functions": {
    "api/pup-meta.ts": {
      "includeFiles": "{dist/**,index.html}"
    },
    "api/og/pup.ts": {
      "includeFiles": "{fonts/**,public/**}"
    },
    "api/og.ts": {
      "includeFiles": "{fonts/**,public/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(index\\.html|sw\\.js|registerSW\\.js|manifest\\.webmanifest|manifest\\.json|$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/og/pup",
      "destination": "/api/og/pup.ts"
    },
    {
      "source": "/api/og",
      "destination": "/api/og/pup.ts"
    },
    {
      "source": "/share-target",
      "destination": "/api/share-target"
    },
    {
      "source": "/pup/:slug",
      "destination": "/api/pup-meta.ts?slug=:slug"
    },
    {
      "source": "/safety/:slug",
      "destination": "/api/pup-meta.ts?slug=:slug"
    },
    {
      "source": "/:slug((?!assets/|api/|home|tasks|ai|academy|more|potty|health|expenses|vault|socialization|journal|recap|puppy|profile|sharing|settings|onboarding|privacy|terms|auth|signin|signup|login|paddlelog|share-target|favicon|icon|manifest|sw|registerSW|.*\\..*)[^/]+)",
      "destination": "/api/pup-meta.ts?slug=$1"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
